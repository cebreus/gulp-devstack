node -e "
const fs = require('fs');
const content = fs.readFileSync('$1', 'utf8');
const lines = content.split('\n');
if (lines.length > 1 && lines[0].trim() && lines[1].trim()) {
  lines.splice(1, 0, '');
  fs.writeFileSync('$1', lines.join('\n'));
}
" && npx remark "$1" --output --silent
npx commitlint --edit "$1"
