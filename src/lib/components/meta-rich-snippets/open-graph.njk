{% if page.open_graph.use and page.open_graph.use %}

  {% if page.open_graph.type %}
    <meta property="og:type" content="{{ page.open_graph.type }}" />
  {% endif %}
  {% if page.open_graph.url %}
    <meta property="og:url" content="{{ page.open_graph.url }}" />
  {% endif %}
  {% if site.open_graph.app_id %}
    <meta property="fb:app_id" content="{{ site.open_graph.app_id }}" />
  {% endif %}
  {% if site.open_graph.site_name %}
    <meta property="og:site_name" content="{{ site.open_graph.site_name | striptags }}" />
  {% endif %}
  {% if page.open_graph.title %}
    <meta property="og:title" content="{{ page.open_graph.title | striptags }}" />
  {% endif %}
  {% if page.open_graph.description %}
    <meta property="og:description" content="{{ page.open_graph.description | striptags }}" />
  {% endif %}
  {% if page.open_graph.image | length > 0 %}
    {% for item in page.open_graph.image %}
      {% if loop.index <= 9 %}
        <meta property="og:image" content="{{ item }}" />
        {# <meta property="og:image:type" content="png"> #}
        {# <meta property="og:image:width" content="1200"> #}
        {# <meta property="og:image:height" content="627"> #}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
