{% macro card(title="", body="", icon="", badge="", footer="", img="", href="", variant="", featured=false, compact=false, class="", iconClass="", bodyClass="") %}
  {% if href %}
    <a href="{{ href }}" class="c-card__link">
      {{ _card_content(title, body, icon, badge, footer, img, variant, featured, compact, class, iconClass, bodyClass, caller) }}
    </a>
  {% else %}
    {{ _card_content(title, body, icon, badge, footer, img, variant, featured, compact, class, iconClass, bodyClass, caller) }}
  {% endif %}
{% endmacro %}

{% macro _card_content(title, body, icon, badge, footer, img, variant, featured, compact, class, iconClass, bodyClass, caller) %}
  <div
    class="c-card 
    {% if variant %}c-card--{{ variant }}{% endif %} 
    {% if featured %}c-card--featured{% endif %} 
    {% if compact %}c-card--compact-title{% endif %} 
    {{ class }}"
  >
    <div class="c-card__inner">
      {% if icon %}
        <div class="c-card__icon {{ iconClass }}">
          {% if '.svg' in icon %}
            {% include icon %}
          {% else %}
            {{ icon | safe }}
          {% endif %}
        </div>
      {% endif %}

      <div class="c-card__body {{ bodyClass }}">
        {% if title %}
          <h3 class="c-card__title">{{ title | safe }}</h3>
        {% endif %}

        {% if body %}
          <p class="c-card__description">{{ body | safe }}</p>
        {% endif %}

        {% if caller %}
          <div class="c-card__custom-content"> {{ caller() }} </div>
        {% endif %}

        {% if img %}
          <div class="c-card__visual"> {{ img | safe }} </div>
        {% endif %}
      </div>

      {% if footer %}
        <div class="c-card__footer"> {{ footer | safe }} </div>
      {% endif %}
    </div>

    {% if badge %}
      <span class="c-card__badge badge rounded-pill">{{ badge }}</span>
    {% endif %}

    {# Visual flair #}
    <div class="c-card__glow"></div>
  </div>
{% endmacro %}
