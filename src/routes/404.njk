{%
  set page = {
    seo: {
      title: "404 - Page Not Found",
      description: "Sorry, the page you are looking for doesn't exist or has been moved.",
      robots: "noindex, follow"
    }
  }
%}
{% extends "layout-minimal.njk" %}
{% from "components/hero/hero.njk" import hero %}
{% block content %}
  {%
    call hero(
      title = "404",
      badge = "Page Not Found",
      description = "Sorry, the page you are looking for doesn't exist or has been moved to a different section.",
      modifier = "no-gradient",
      class = "w-100"
    )
  %}
    <div class="d-flex justify-content-center mt-3">
      <a href="/" class="btn btn-primary btn-lg rounded-pill px-4 py-2"> Back to home </a>
    </div>
  {% endcall %}
{% endblock %}
