{% extends "layout-default.njk" %}
{% block content %}
  {% from "components/card/card.njk" import card %}

  <div class="container py-5 c-about">
    <section class="c-about__section c-about__section--intro">
      <div class="row g-4 g-xl-5 align-items-start">
        <div class="col-xl-7">
          <div class="c-about__intro-copy">
            <div class="c-about__eyebrow">How to choose</div>
            <h2 class="c-about__headline">What this project offers.</h2>
            <div class="text-muted lead mb-0">{{ page.content | md | safe }}</div>
          </div>
        </div>
        <div class="col-xl-5">
          <div class="d-flex flex-column gap-4">
            {% set positives_img %}
              <div class="c-feature-list">
                <div class="c-feature-list__grid">
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">File-based Routing:</span>
                      <span class="c-feature-item__text">Automatic routes with templates even MD/JS/SCSS.</span>
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Modular Components:</span>
                      <span class="c-feature-item__text">Encapsulated UI modules with a simple CLI.</span>
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Bootstrap 5.3 &amp; BEM:</span>
                      <span class="c-feature-item__text">Modern styling with built-in BEM methodology linter.</span>
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Git-based CMS:</span>
                      <span class="c-feature-item__text"
                        >Workflows where content stays in version control with clean source files.</span
                      >
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Asset Revisioning:</span>
                      <span class="c-feature-item__text">Deterministic file hashing for perfect cache busting.</span>
                    </div>
                  </div>
                </div>
              </div>
            {% endset %}

            {{
              card(
                title = "Control Over Abstraction",
                variant = "bento",
                featured = true,
                img = positives_img
              )
            }}


            {% set negatives_img %}
              <div class="c-feature-list">
                <div class="c-feature-list__grid">
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Dynamic web apps:</span>
                      <span class="c-feature-item__text"
                        >There is no client router, server rendering, or complex app logic.</span
                      >
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Heavy JavaScript workflows:</span>
                      <span class="c-feature-item__text"
                        >CSS updates automatically, but JavaScript updates reload the whole page.</span
                      >
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">CMS as a product:</span>
                      <span class="c-feature-item__text"
                        >You can connect this to a CMS, but it is not a content management system itself.</span
                      >
                    </div>
                  </div>
                  <div class="c-feature-item">
                    <span class="c-feature-item__icon"></span>
                    <div class="c-feature-item__content">
                      <span class="c-feature-item__title">Complex UI:</span>
                      <span class="c-feature-item__text"
                        >If your site needs rich client state, use a framework tool like Next.js.</span
                      >
                    </div>
                  </div>
                </div>
              </div>
            {% endset %}

            {{
              card(
                title = "When to choose another tool",
                variant = "bento",
                img = negatives_img
              )
            }}
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="fidelity">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Output Fidelity</strong> (<code>#fidelity</code>)</span
        >
      </div>
      <div class="row g-4 g-xl-5">
        <div class="col-xl-12">
          <div class="c-about__section-head">
            <div class="c-about__eyebrow">Who is this for?</div>
            <h2 class="c-about__section-title mb-2">Who should use this?</h2>
            <p class="text-muted mb-0"
              >It is best for teams that want one codebase for local work, sharing, and launching.</p
            >
          </div>
          <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mt-1">
            <div class="col">
              <div class="c-about__mini-surface h-100">
                <h3 class="h6 mb-2">Frontend developers</h3>
                <p class="small text-muted mb-0"
                  >You want your own HTML, CSS, and JS code to stay clear and clean in the final files.</p
                >
              </div>
            </div>
            <div class="col">
              <div class="c-about__mini-surface h-100">
                <h3 class="h6 mb-2">Technical leads</h3>
                <p class="small text-muted mb-0"
                  >You want safe builds, clear steps, and a simple way to launch websites.</p
                >
              </div>
            </div>
            <div class="col">
              <div class="c-about__mini-surface h-100">
                <h3 class="h6 mb-2">Agencies and freelancers</h3>
                <p class="small text-muted mb-0"
                  >You need clean files that another team or client can easily read and use.</p
                >
              </div>
            </div>
            <div class="col">
              <div class="c-about__mini-surface h-100">
                <h3 class="h6 mb-2">Maintainers</h3>
                <p class="small text-muted mb-0"
                  >You like clear folders and files, and you do not want hidden build magic.</p
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="abstraction">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Control Over Abstraction</strong> (<code>#abstraction</code>)</span
        >
      </div>
      <div class="row g-4">
        <div class="col-lg-6">
          <h2 class="c-about__section-title">Why teams choose this tool</h2>
          <ul class="small text-muted mb-0">
            <li class="mb-3"
              ><strong>Simple structure:</strong> The same files are used for work, sharing, and launching.</li
            >
            <li class="mb-3"
              ><strong>Clean code:</strong> You get readable HTML, CSS, and JS files that are easy to check.</li
            >
            <li class="mb-3"
              ><strong>Safe launches:</strong> Security and speed optimizations are only done for the final live
              site.</li
            >
            <li><strong>Clear steps:</strong> You can easily see how your styles, scripts, and files are processed.</li>
          </ul>
        </div>
        <div class="col-lg-6">
          <h2 class="c-about__section-title">When not to use this tool</h2>
          <ul class="small text-muted mb-0">
            <li class="mb-3"
              ><strong>No dynamic app code:</strong> No server-side rendering or complex client routing.</li
            >
            <li class="mb-3"
              ><strong>No instant JS reload:</strong> Styles update live in the browser, but script changes reload the
              page.</li
            >
            <li class="mb-3"><strong>No CMS:</strong> You need other tools to manage text and database content.</li>
            <li
              ><strong>No complex state:</strong> Use a framework if your UI depends on a lot of client-side state.</li
            >
          </ul>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="pipeline">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Triple Pipeline Strategy</strong> (<code>#pipeline</code>)</span
        >
      </div>
      <div class="c-about__section-head">
        <div class="c-about__eyebrow">How it works</div>
        <h2 class="c-about__section-title mb-2">Three modes for different tasks</h2>
        <p class="text-muted mb-0">
          Your code can produce three different types of files because writing code, sharing code, and launching a site
          are different.
        </p>
      </div>
      <div class="row row-cols-1 row-cols-lg-3 g-4">
        <div class="col">
          {{
            card(
              title = "Dev",
              body = "Use <code>pnpm dev</code> to work on your computer with automatic browser reloads.",
              badge = "Work",
              variant = "bento",
              featured = true,
              class = "h-100"
            )
          }}
        </div>
        <div class="col">
          {{
            card(
              title = "Export",
              body = "Use <code>pnpm export</code> to create clean, readable code for clients without dynamic filenames.",
              badge = "Share",
              variant = "bento",
              class = "h-100"
            )
          }}
        </div>
        <div class="col">
          {{
            card(
              title = "Build",
              body = "Use <code>pnpm build</code> to optimize and secure files for the live website.",
              badge = "Launch",
              variant = "bento",
              class = "h-100"
            )
          }}
        </div>
      </div>
      <div class="c-about__surface c-about__surface--table mt-4 p-3 p-lg-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3">
          <div>
            <div class="c-about__eyebrow">Details</div>
            <h3 class="h5 mb-0">Mode comparison table</h3>
          </div>
          <p class="small text-muted mb-0">Use this table to see the differences between each mode.</p>
        </div>
        <div class="table-responsive"> {% include "about/_pipeline-table.njk" %} </div>
      </div>
    </section>

    <section class="c-about__section" id="export-mode">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Professional Handoff</strong> (<code>#export-mode</code>)</span
        >
      </div>
      <div class="c-about__section-head">
        <div class="c-about__eyebrow">Sharing code</div>
        <h2 class="c-about__section-title mb-2">Why we have export mode</h2>
        <p class="text-muted mb-0"
          >It creates clean, simple files for clients or other teams to read before we optimize them for the live
          site.</p
        >
      </div>
      <div class="row g-4">
        <div class="col-md-6 col-xl-3">
          <div class="c-about__step">
            <h3 class="h6 fw-semibold">1. Easy to read</h3>
            <p class="small text-muted mb-0">Templates, text, styles, and scripts are organized near their pages.</p>
          </div>
        </div>
        <div class="col-md-6 col-xl-3">
          <div class="c-about__step">
            <h3 class="h6 fw-semibold">2. Easy to check</h3>
            <p class="small text-muted mb-0"
              >All files are readable and do not have random names. Other teams can easily inspect them.</p
            >
          </div>
        </div>
        <div class="col-md-6 col-xl-3">
          <div class="c-about__step">
            <h3 class="h6 fw-semibold">3. Keep optimizations separate</h3>
            <p class="small text-muted mb-0"
              >Security checks and code shrinking only happen in build mode. This keeps your shared files readable.</p
            >
          </div>
        </div>
        <div class="col-md-6 col-xl-3">
          <div class="c-about__step">
            <h3 class="h6 fw-semibold">4. Choose what you need</h3>
            <p class="small text-muted mb-0"
              >You can use the same code to work locally, show work to others, or launch the website.</p
            >
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="security">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Security Hardened</strong> (<code>#security</code>)</span
        >
      </div>
      <div class="row g-4 align-items-start">
        <div class="col-lg-7">
          <div class="c-about__eyebrow">Security and safety</div>
          <h2 class="c-about__section-title">Safe and secure websites</h2>
          <p class="text-muted mb-4">
            The final files are made secure and fast so they can be saved, checked, and validated safely.
          </p>
          <ul class="small text-muted mb-0">
            <li class="mb-3"
              ><strong>Security (SRI):</strong> The build adds safety codes to your scripts and styles. This stops
              anyone from changing your files.</li
            >
            <li class="mb-3"
              ><strong>Version control:</strong> File names get unique codes. This helps web browsers load new versions
              instantly.</li
            >
            <li class="mb-3"
              ><strong>Testing:</strong> The tool checks the HTML code and runs tests automatically before you
              launch.</li
            >
            <li
              ><strong>Clean separation:</strong> Security and speed work is done in build mode, while export mode stays
              simple for reviews.</li
            >
          </ul>
        </div>
        <div class="col-lg-5">
          <div class="c-card c-card--bento h-100">
            <div class="c-card__inner">
              <div class="c-card__body">
                <h3 class="h5 mb-3">How this helps you</h3>
                <p class="small text-muted mb-0">
                  You can share clean, readable files with clients, and use secure, fast files for the live website.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="cli">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Component CLI</strong> (<code>#cli</code>)</span
        >
      </div>
      <div class="row g-4 align-items-center">
        <div class="col-lg-7">
          <div class="c-about__eyebrow">Developer tools</div>
          <h2 class="c-about__section-title">Easy component tool</h2>
          <p class="text-muted mb-4">
            This tool helps you create and manage components easily. It keeps your files clean and organized.
          </p>
          <div class="row row-cols-1 row-cols-sm-2 g-3 small text-muted">
            <div class="col"><strong>Create:</strong> Make new component files quickly.</div>
            <div class="col"><strong>Rename:</strong> Change a component name safely.</div>
            <div class="col"><strong>Remove:</strong> Delete old component files.</div>
            <div class="col"><strong>List:</strong> See all your current components.</div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="c-about__surface p-4 text-center">
            <div class="small text-uppercase text-muted mb-2">CLI Entry Point</div>
            <code class="fs-5 text-info">pnpm run component</code>
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="stack">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Stack Integrations</strong> (<code>#stack</code>)</span
        >
      </div>
      <div class="c-about__section-head">
        <div class="c-about__eyebrow">Built with</div>
        <h2 class="c-about__section-title mb-2">Integrated tools</h2>
      </div>
      <p class="text-muted mb-4">
        This project connects top tools together. It makes them work well and predictably, without being a complex
        framework.
      </p>
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <div class="col">
          {{ card(title = "Nunjucks + Markdown", body = "Nunjucks is used for layouts and Markdown is used for your written page content.", icon = "nunjucks.svg", variant = "bento", class = "h-100") }}
        </div>
        <div class="col">
          {{ card(title = "Sass + PostCSS", body = "Your styles are processed quickly into clean, fast CSS files.", icon = "sass.svg", variant = "bento", class = "h-100") }}
        </div>
        <div class="col">
          {{ card(title = "esbuild", body = "Your JavaScript files are compiled and bundled, not loaded 1:1. They are loaded in the browser as ES Modules (using <code>type=\"module\"</code>).", icon = "esbuild.svg", variant = "bento", class = "h-100") }}
        </div>
        <div class="col">
          {{ card(title = "Images + Fonts", body = "Images and web fonts are automatically optimized and converted for speed.", icon = "images.svg", variant = "bento", class = "h-100") }}
        </div>
        <div class="col">
          {{ card(title = "Validation + Tests", body = "The code is checked and tested automatically to ensure there are no errors.", icon = "shield-lock.svg", variant = "bento", class = "h-100") }}
        </div>
        <div class="col">
          {{ card(title = "Node 24 + ESM", body = "The project uses modern, clean JavaScript patterns and native Node.js tools.", icon = "gulp.svg", variant = "bento", class = "h-100") }}
        </div>
      </div>
    </section>

    <section class="c-about__section" id="env">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Configurable ENV</strong> (<code>#env</code>)</span
        >
      </div>
      <div class="row row-cols-1 row-cols-lg-2 g-4">
        <div class="col">
          <div class="c-about__mini-surface h-100">
            <div class="c-about__eyebrow">Settings</div>
            <h2 class="c-about__section-title mb-3">Easy configuration</h2>
            <p class="text-muted mb-0">
              Site details and environment settings are kept in one place. The same files support local work, exports,
              and the live site.
            </p>
          </div>
        </div>
        <div class="col" id="quality">
          <div class="c-about__mini-surface h-100">
            <div class="mb-3">
              <span class="c-about__hash-hint"
                >⚓ Linked from homepage: <strong>Interactive Logger</strong> (<code>#quality</code>)</span
              >
            </div>
            <div class="c-about__eyebrow">Health and Quality</div>
            <h2 class="c-about__section-title mb-3">Automatic checks</h2>
            <p class="text-muted mb-0">
              The project logs errors, formats code, validates HTML, and runs checks to keep the site healthy.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section" id="autopilot">
      <div class="mb-3">
        <span class="c-about__hash-hint"
          >⚓ Linked from homepage: <strong>Asset Autopilot</strong> (<code>#autopilot</code>)</span
        >
      </div>
      <div class="c-about__eyebrow">File processing</div>
      <h2 class="c-about__section-title">Automatic asset handling</h2>
      <p class="text-muted mb-4">
        Images and fonts are processed automatically, so you do not have to optimize them manually.
      </p>
      <div class="row g-4 align-items-center">
        <div class="col-lg-7">
          <ul class="small text-muted mb-0">
            <li class="mb-3">You can use original assets for fast local work.</li>
            <li class="mb-3">Export and build modes automatically create next-generation formats for speed.</li>
            <li>All processing is done automatically behind the scenes, leaving your content clean.</li>
          </ul>
        </div>
        <div class="col-lg-5">
          <div class="c-about__surface p-4 text-center">
            <picture>
              <source srcset="/assets/images/smajlik.avif" type="image/avif" />
              <source srcset="/assets/images/smajlik.webp" type="image/webp" />
              <img
                src="/assets/images/smajlik.jpg"
                alt="Optimized smile"
                class="img-fluid rounded-2 shadow-sm c-about__autopilot-img"
              />
            </picture>
            <div class="mt-2 small text-muted"
              >Example of one authored image delivered through multiple optimized formats.</div
            >
          </div>
        </div>
      </div>
    </section>

    <section class="c-about__section c-about__section--no-bottom">
      <div class="row g-4 align-items-start">
        <div class="col-lg-7">
          <div class="c-about__eyebrow">Next Step</div>
          <h2 class="c-about__section-title">See the design examples</h2>
          <p class="text-muted mb-4">
            This page explains how the tool works. The design system, cards, and styling live on the Showcase page.
          </p>
          <p class="small text-muted mb-0"> Visit the Showcase page to see cards, design tokens, and components. </p>
        </div>
        <div class="col-lg-5">
          <div class="c-about__surface c-about__surface--cta p-4">
            <h3 class="h5 mb-3">Showcase</h3>
            <p class="small text-muted mb-3">View the visual design elements, styling, and card examples.</p>
            <div class="d-flex flex-wrap gap-2">
              <a href="/showcase/" class="btn btn-primary">Visual examples</a>
              <a href="/" class="btn btn-outline-primary">Go Home</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
{% endblock %}
