<table class="table table-sm table-hover small mb-0 c-about__table">
  <thead>
    <tr>
      <th scope="col" class="w-cat ps-3">Category</th>
      <th scope="col" class="w-feature">Feature</th>
      <th scope="col" class="w-mode">Dev</th>
      <th scope="col" class="w-mode">Export</th>
      <th scope="col" class="w-mode">Build</th>
    </tr>
  </thead>
  <tbody>
    {%
      set pipeline_features = [
        {
          name: 'JavaScript',
          items: [
            { label: 'esbuild (ESM)', desc: 'Modern JS bundler. Handles Bundling &amp; Tree-shaking. Output: /assets/js/', dev: 'Instant rebuilds', export: 'Bundling + beautification', build: 'Tree-shaking + minification' },
            { label: 'Sourcemaps', desc: 'Debug production code', dev: true, export: false, build: false },
            { label: 'Bundled', desc: 'Single file delivery', dev: false, export: true, build: true },
            { label: 'Optimization', desc: 'Minify or beautify', dev: false, export: 'Beautified', build: 'Minified' }
          ]
        },
        {
          name: 'SCSS / CSS',
          items: [
            { label: 'Compiles', desc: 'Sass to CSS transform', dev: true, export: true, build: true },
            { label: 'Autoprefixer', desc: 'Browser compatibility', dev: true, export: true, build: true },
            { label: 'Sourcemaps', desc: 'Debug production code', dev: true, export: false, build: false },
            { label: 'PurgeCSS', desc: 'Remove unused styles', dev: false, export: true, build: true },
            { label: 'Optimization', desc: 'Minify or beautify', dev: false, export: 'Beautified', build: 'Minified' }
          ]
        },
        {
          name: 'HTML / NJK',
          items: [
            { label: 'Layout &amp; rendering', desc: 'Modular NJK templates', dev: true, export: true, build: true },
            { label: 'Scripts injection', desc: 'Auto-linking assets', dev: true, export: true, build: true },
            { label: 'Optimization', desc: 'Minify or beautify', dev: false, export: 'Beautified', build: 'Minified' }
          ]
        },
        {
          name: 'Images',
          items: [
            { label: 'Raw files', desc: 'Direct dev access', dev: true, export: false, build: false },
            { label: 'Optimized (WebP/avif)', desc: 'Next-gen compression', dev: false, export: true, build: true },
            { label: 'Multi-format', desc: 'Responsive assets', dev: false, export: true, build: true }
          ]
        },
        {
          name: 'Security (SRI)',
          items: [
            { label: 'SRI Hash generation', desc: 'Prevention of tampering', dev: false, export: false, build: true },
            { label: 'Integrity checks', desc: 'Verified asset delivery', dev: false, export: false, build: true }
          ]
        },
        {
          name: 'Revisioning',
          items: [
            { label: 'Asset Hashing (Rev)', desc: 'Instant cache busting', dev: false, export: false, build: true },
            { label: 'Long-term caching', desc: 'Permanent safe storage', dev: false, export: false, build: true }
          ]
        },
        {
          name: 'Deployment',
          items: [
            { label: 'Local Server', desc: 'Live preview hub', dev: 'Local Server', export: 'Static Distribution', build: 'CI/CD Ready' },
            { label: 'Browsersync HMR', desc: 'Instant UI updates', dev: true, export: false, build: false }
          ]
        }
      ]
    %}
    {% for category in pipeline_features %}
      {% for item in category.items %}
        {% set item_loop = loop %}
        <tr>
          {% if item_loop.first %}
            <th scope="row" rowspan="{{ category.items | length }}" class="ps-3 fw-bold align-middle border-end"
              >{{ category.name }}</th
            >
          {% endif %}
          <td>
            <div class="fw-bold">{{ item.label }}</div>
            <div class="text-muted xsmall">{{ item.desc }}</div>
          </td>
          {% for mode in ['dev', 'export', 'build'] %}
            {% set val = item[mode] %}
            {% set seen_in_dev = item.dev != false and item.dev != '' %}
            {% set seen_in_export = seen_in_dev or (item.export != false and item.export != '') %}
            {% set seen_in_build = seen_in_export or (item.build != false and item.build != '') %}
            {% set should_show = (mode == 'dev' and seen_in_dev) or (mode == 'export' and seen_in_export) or (mode == 'build' and seen_in_build) %}
            <td>
              {% if should_show %}
                {% if val == true %}
                  ✅
                {% elif val == false or val == '' %}
                  &mdash;
                {% else %}
                  {{ val }}
                {% endif %}
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    {% endfor %}
  </tbody>
</table>
