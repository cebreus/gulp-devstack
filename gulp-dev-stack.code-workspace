{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true,
    "files.exclude": {
      "**/node_modules": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/build*": true,
      "**/build-dev": true,
      "**/build-prod": true,
      "**/build-export": true,
      "**/.temp": true,
      "**/coverage": true,
      "**/graphify-out": true,
      "**/.cache": true,
      "**/.eslintcache": true
    },
    "files.associations": {
      "*.njk": "nunjucks",
      "*.hbs": "handlebars"
    },
    "emmet.includeLanguages": {
      "nunjucks": "html",
      "njk": "html"
    },
    "css.remoteStyleSheets": [
      "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    ],
    "attrsSorter.order": [
      "v-.*",
      "ng-.*",
      "mkt-block.*",
      "mkt-data-.*",
      "mkt-label-.*",
      "mkt-field-.*",
      "mkt-.*",
      "class",
      "id",
      "async",
      "defer",
      "rel",
      "name",
      "property",
      "content",
      "lang",
      "hreflang",
      "http-equiv",
      "media",
      "method",
      "action",
      "for",
      "type",
      "value",
      "label",
      "cols",
      "rows",
      "min",
      "max",
      "maxlength",
      "multiple",
      "checked",
      "disabled",
      "hidden",
      "readonly",
      "required",
      "selected",
      "placeholder",
      "autocomplete",
      "width",
      "height",
      "href",
      "target",
      "src",
      "srcset",
      "size",
      "sizes",
      "alt",
      "title",
      "border",
      "cellpadding",
      "cellspacing",
      "align",
      "valign",
      "summary",
      "colspan",
      "rowspan",
      "bgcolor",
      "background",
      "data-.*",
      "aria-.*"
    ],
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#123364",
      "activityBar.background": "#123364",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#bd2260",
      "activityBarBadge.foreground": "#e7e7e7",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#123364",
      "statusBar.background": "#0a1d39",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#123364",
      "statusBarItem.remoteBackground": "#a31d53",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#0a1d39",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#0a1d3999",
      "titleBar.inactiveForeground": "#e7e7e799",
      "activityBarTop.activeBackground": "#123364",
      "activityBarTop.background": "#123364",
      "activityBarTop.foreground": "#e7e7e7",
      "activityBarTop.inactiveForeground": "#e7e7e799",
      "commandCenter.foreground": "#e7e7e7",
      "statusBar.debuggingBackground": "#0a1d39",
      "statusBar.debuggingForeground": "#e7e7e7"
    },
    "peacock.color": "#0a1d39"
  },
  "extensions": {
    "recommendations": [
      "okitavera.vscode-nunjucks-formatter",
      "editorconfig.editorconfig",
      "mrmlnc.vscode-attrs-sorter",
      "mikestead.dotenv",
      "redhat.vscode-yaml",
      "yzhang.markdown-all-in-one",
      "dbaeumer.vscode-eslint",
      "stylelint.vscode-stylelint",
      "esbenp.prettier-vscode",
      "ms-playwright.playwright",
      "html-validate.vscode-html-validate"
    ]
  }
}
