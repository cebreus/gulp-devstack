{
	"name": "gulp-devstack",
	"version": "4.5.0",
	"description": "Basic Gulp DevStack for basic front-end development with customized Bootstrap.",
	"scripts": {
		"start": "npm run dev",
		"build": "node ./node_modules/gulp/bin/gulp.js -f gulpfile.build.js default",
		"build:validate:html": "node ./node_modules/gulp/bin/gulp.js -f gulpfile.build.js validate",
		"dev": "node --env-file=.env.local ./node_modules/gulp/bin/gulp.js -f gulpfile.js serve",
		"export": "node --env-file=.env.local ./node_modules/gulp/bin/gulp.js -f gulpfile.export.js default",
		"export:validate:html": "gulp -f gulpfile.export.js validate",
		"commit": "npx git-cz",
		"lint": "npm-run-all --parallel --continue-on-error lint:*",
		"lint:js": "eslint .",
		"lint:css": "stylelint '**/*.scss'",
		"lint:md": "remark . --frail --quiet",
		"lint:templates": "njklint src/",
		"lint:prettier": "prettier . --check",
		"format": "npm-run-all --serial format:*",
		"format:js": "eslint . --fix",
		"format:css": "stylelint '**/*.scss' --fix",
		"format:md": "remark . --output",
		"format:templates": "njklint src/ --fix",
		"format:prettier": "prettier . --write",
		"release": "npx release-it",
		"todo": "node ./node_modules/gulp/bin/gulp.js -f gulpfile.js todo",
		"todo:show": "npx leasot -x -r markdown -A '.txt,coffeeParser' './**/*.{js,html,njk,scss,txt,md,yml}' -i './node_modules/**/*'",
		"husky-init": "rm -rf .husky && husky init && echo \"npx lint-staged\" > .husky/pre-commit && echo \"npx commitlint --edit\" > .husky/commit-msg",
		"prepare": "husky",
		"snyk-protect": "npx snyk-protect",
		"debug": "DEBUG=true NODE_ENV=development gulp serve",
		"debug:meta": "DEBUG_META=true NODE_ENV=development gulp serve",
		"test": "node --test gulp/tasks/*.test.js",
		"component": "node ./node_modules/gulp/bin/gulp.js -f gulpfile.js components"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cebreus/gulp-devstack.git"
	},
	"homepage": "https://github.com/cebreus/gulp-devstack#readme",
	"author": "Jaroslav Vrana <cebreus@live.com>",
	"private": false,
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/cebreus/gulp-devstack/issues",
		"email": "cebreus@live.com"
	},
	"keywords": [
		"devstack",
		"gulp",
		"bootstrap"
	],
	"engines": {
		"node": ">=22"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix"
		],
		"*.scss": [
			"stylelint --fix --allow-empty-input"
		],
		"*.md": [
			"remark --output"
		],
		"*.{css,scss,md,js,json}": [
			"prettier --write"
		],
		"*.njk": [
			"njklint --fix"
		]
	},
	"snyk": true,
	"dependencies": {
		"bootstrap": "5.3.7",
		"nunjucks-date-filter-locale": "^1.4.3",
		"nunjucks-markdown-filter": "^0.1.0"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/preset-env": "^7.28.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.3.1",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.30.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.4.2",
		"@j-ulrich/release-it-regex-bumper": "^5.3.0",
		"@release-it/conventional-changelog": "^10.0.1",
		"@snyk/protect": "^1.1297.3",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@visionappscz/stylelint-config": "^4.0.0",
		"autoprefixer": "^10.4.21",
		"browser-sync": "^3.0.4",
		"cssnano": "^7.0.7",
		"del": "^8.0.0",
		"depcheck": "^1.4.7",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^51.3.3",
		"eslint-plugin-regexp": "^2.9.0",
		"favicons": "^7.2.0",
		"glob": "^11.0.3",
		"globals": "^16.3.0",
		"gray-matter": "^4.0.3",
		"gulp": "^5.0.1",
		"gulp-babel": "^8.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-data": "^1.3.1",
		"gulp-empty-pipe": "^5.0.0",
		"gulp-google-webfonts": "^4.1.0",
		"gulp-html-validate": "github:cebreus/gulp-html-validate",
		"gulp-if": "^3.0.0",
		"gulp-imagemin": "^9.1.0",
		"gulp-inject": "^5.0.5",
		"gulp-jsbeautifier": "^3.0.1",
		"gulp-json-editor": "^2.6.0",
		"gulp-newer": "^1.4.0",
		"gulp-nunjucks": "^6.0.0",
		"gulp-nunjucks-render": "^2.2.3",
		"gulp-plumber": "^1.2.1",
		"gulp-postcss": "^10.0.0",
		"gulp-purgecss": "^7.0.2",
		"gulp-real-favicon": "^0.3.2",
		"gulp-rename": "^2.1.0",
		"gulp-replace": "^1.1.4",
		"gulp-rev": "^11.0.0",
		"gulp-rev-delete-original": "^0.2.3",
		"gulp-rev-replace": "^0.4.4",
		"gulp-rev-rewrite": "^6.0.0",
		"gulp-sass": "^6.0.1",
		"gulp-sass-glob": "^1.1.0",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-sri-hash": "^2.2.1",
		"gulp-terser": "^2.1.0",
		"gulp-todo": "^7.1.1",
		"gulp-uglify": "^3.0.2",
		"gulp-upng": "^1.0.3",
		"html-validate": "^9.7.1",
		"husky": "^9.1.7",
		"imagemin-mozjpeg": "^10.0.0",
		"imagemin-svgo": "^11.0.1",
		"lint-staged": "^16.1.2",
		"markdown-it": "^14.1.0",
		"merge-deep": "^3.0.3",
		"mock-fs": "^5.5.0",
		"npm-run-all": "^4.1.5",
		"nunjucklinter": "^1.3.0",
		"picocolors": "^1.1.1",
		"postcss": "^8.5.6",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.6.2",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-jinja-template": "^2.1.0",
		"prompts": "^2.4.2",
		"release-it": "^19.0.3",
		"remark": "^15.0.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-lint": "^10.0.1",
		"remark-lint-code": "^2.0.0",
		"remark-lint-heading-whitespace": "^1.0.0",
		"remark-lint-match-punctuation": "^0.2.1",
		"remark-lint-no-dead-urls": "^2.0.1",
		"remark-lint-no-duplicate-headings": "^4.0.1",
		"remark-preset-lint-consistent": "^6.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"sass": "^1.89.2",
		"stylelint": "^16.21.0",
		"stylelint-config-prettier-scss": "^1.0.0",
		"stylelint-config-standard-scss": "^15.0.1",
		"stylelint-high-performance-animation": "^1.11.0",
		"stylelint-selector-bem-pattern": "^4.0.1",
		"through2": "^4.0.2",
		"winston": "^3.17.0"
	}
}
