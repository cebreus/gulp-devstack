{
	"name": "gulp-devstack",
	"version": "4.5.0",
	"description": "Basic Gulp DevStack for basic front-end development with customized Bootstrap.",
	"scripts": {
		"start": "npm run dev",
		"init:template": "node scripts/init-template.js",
		"build": "BUILD_MODE=build node ./node_modules/gulp/bin/gulp.js",
		"build:validate:html": "BUILD_MODE=build node ./node_modules/gulp/bin/gulp.js htmlValidate",
		"dev": "BUILD_MODE=dev node ./node_modules/gulp/bin/gulp.js dev",
		"export": "BUILD_MODE=export node ./node_modules/gulp/bin/gulp.js",
		"export:validate:html": "BUILD_MODE=export node ./node_modules/gulp/bin/gulp.js htmlValidate",
		"commit": "npx git-cz",
		"lint": "npm-run-all --parallel --continue-on-error lint:*",
		"lint:js": "eslint .",
		"lint:css": "stylelint '**/*.scss'",
		"lint:md": "remark . --frail --quiet",
		"lint:templates": "njklint src/",
		"lint:prettier": "prettier . --check",
		"format": "npm-run-all --serial format:*",
		"format:js": "eslint . --fix",
		"format:css": "stylelint '**/*.scss' --fix",
		"format:md": "remark . --output --quiet",
		"format:templates": "njklint src/ --fix",
		"format:prettier": "prettier . -l -w",
		"release": "npx release-it",
		"todo": "node ./node_modules/gulp/bin/gulp.js -f gulpfile.js todo",
		"todo:show": "npx leasot -x -r markdown -A '.txt,coffeeParser' './**/*.{js,html,njk,scss,txt,md,yml}' -i './node_modules/**/*'",
		"husky-init": "rm -rf .husky && husky init && echo \"npx lint-staged\" > .husky/pre-commit && echo \"npx commitlint --edit\" > .husky/commit-msg",
		"prepare": "husky",
		"debug": "DEBUG=true NODE_ENV=development gulp dev",
		"debug:meta": "DEBUG_META=true NODE_ENV=development gulp dev",
		"test": "node --test tests/**/*.test.js",
		"test:unit": "node --test tests/unit/**/*.test.js",
		"test:integration": "node --test tests/integration/**/*.test.js",
		"test:smoke": "node --test tests/smoke/**/*.test.js",
		"test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js",
		"component": "node ./node_modules/gulp/bin/gulp.js -f gulpfile.js components"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cebreus/gulp-devstack.git"
	},
	"homepage": "https://github.com/cebreus/gulp-devstack#readme",
	"author": "Jaroslav Vrana <cebreus@live.com>",
	"private": false,
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/cebreus/gulp-devstack/issues",
		"email": "cebreus@live.com"
	},
	"keywords": [
		"devstack",
		"gulp",
		"bootstrap"
	],
	"engines": {
		"node": ">=22"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix"
		],
		"*.scss": [
			"stylelint --fix --allow-empty-input"
		],
		"*.md": [
			"remark --output --quiet --frail"
		],
		"*.njk": [
			"njklint --fix"
		],
		"*.{css,scss,md,js,json,njk}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"bootstrap": "5.3.8"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/eslintrc": "^3.3.5",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@j-ulrich/release-it-regex-bumper": "^5.4.0",
		"@popperjs/core": "^2.11.8",
		"@release-it/conventional-changelog": "^10.0.6",
		"@visionappscz/stylelint-config": "^4.0.0",
		"autoprefixer": "^10.4.27",
		"browser-sync": "^3.0.4",
		"cssnano": "^7.1.4",
		"del": "^8.0.1",
		"depcheck": "^1.4.7",
		"esbuild": "^0.27.4",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^51.4.1",
		"eslint-plugin-regexp": "^2.10.0",
		"favicons": "^7.2.0",
		"glob": "^13.0.6",
		"globals": "^17.4.0",
		"gray-matter": "^4.0.3",
		"gulp": "^5.0.1",
		"gulp-concat": "^2.6.1",
		"gulp-data": "^1.3.1",
		"gulp-esbuild": "^0.14.1",
		"gulp-google-webfonts": "^4.1.0",
		"gulp-htmlmin": "^5.0.1",
		"gulp-imagemin": "^9.2.0",
		"gulp-inject": "^5.0.5",
		"gulp-jsbeautifier": "^3.0.1",
		"gulp-newer": "^1.4.0",
		"gulp-nunjucks-render": "^2.2.3",
		"gulp-postcss": "^10.0.0",
		"gulp-purgecss": "^8.0.0",
		"gulp-replace": "^1.1.4",
		"gulp-rev": "^12.0.0",
		"gulp-rev-delete-original": "^0.2.3",
		"gulp-rev-rewrite": "^6.0.0",
		"gulp-sass": "^6.0.1",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-sri-hash": "^2.2.1",
		"gulp-todo": "^7.1.1",
		"gulp-upng": "^1.0.3",
		"html-validate": "^10.11.2",
		"husky": "^9.1.7",
		"imagemin-svgo": "^12.0.0",
		"lint-staged": "^16.4.0",
		"markdown-it": "^14.1.1",
		"mock-fs": "^5.5.0",
		"npm-run-all": "^4.1.5",
		"nunjucklinter": "^1.3.0",
		"picocolors": "^1.1.1",
		"postcss": "^8.5.8",
		"prettier": "^3.8.1",
		"prettier-plugin-jinja-template": "^2.1.0",
		"prompts": "^2.4.2",
		"release-it": "^19.2.4",
		"remark": "^15.0.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-lint": "^10.0.1",
		"remark-lint-code": "^2.0.0",
		"remark-lint-heading-whitespace": "^1.0.0",
		"remark-lint-no-duplicate-headings": "^4.0.1",
		"remark-preset-lint-consistent": "^6.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"sass": "^1.98.0",
		"sharp": "^0.34.5",
		"stylelint": "^17.6.0",
		"stylelint-config-prettier-scss": "^1.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-high-performance-animation": "^2.0.0",
		"stylelint-selector-bem-pattern": "^4.0.1"
	}
}
