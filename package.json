{
	"name": "gulp-devstack",
	"version": "4.5.0",
	"description": "Basic Gulp DevStack for basic front-end development with customized Bootstrap.",
	"scripts": {
		"start": "npm run dev",
		"init:template": "node scripts/init-template.js",
		"build": "cross-env BUILD_MODE=build node ./node_modules/gulp/bin/gulp.js",
		"build:validate:html": "cross-env BUILD_MODE=build node ./node_modules/gulp/bin/gulp.js htmlValidate",
		"dev": "cross-env BUILD_MODE=dev node ./node_modules/gulp/bin/gulp.js dev",
		"export": "cross-env BUILD_MODE=export node ./node_modules/gulp/bin/gulp.js",
		"export:validate:html": "cross-env BUILD_MODE=export node ./node_modules/gulp/bin/gulp.js htmlValidate",
		"commit": "npx git-cz",
		"lint": "npm-run-all --parallel --continue-on-error lint:js lint:css lint:md lint:templates lint:prettier",
		"lint:js": "eslint .",
		"lint:css": "stylelint '**/*.scss'",
		"lint:md": "remark . --frail --quiet",
		"lint:templates": "njklint src/",
		"lint:prettier": "prettier . --check",
		"format": "npm-run-all --serial format:*",
		"format:js": "eslint . --fix",
		"format:css": "stylelint '**/*.scss' --fix",
		"format:md": "remark . --output --quiet",
		"format:templates": "njklint src/ --fix",
		"format:prettier": "prettier . -l -w",
		"release": "node scripts/release.js",
		"todo": "cross-env BUILD_MODE=dev node ./node_modules/gulp/bin/gulp.js -f gulpfile.js todo",
		"todo:show": "npx leasot -x -r markdown -A '.txt,coffeeParser' './**/*.{js,html,njk,scss,txt,md,yml}' -i './node_modules/**/*'",
		"husky-init": "rimraf .husky && husky init && echo npx lint-staged > .husky/pre-commit && echo npx commitlint --edit > .husky/commit-msg",
		"prepare": "husky",
		"debug": "cross-env DEBUG=true NODE_ENV=development gulp dev",
		"debug:meta": "cross-env DEBUG_META=true NODE_ENV=development gulp dev",
		"test": "node --test --test-concurrency=1 tests/unit/**/*.test.js tests/integration/**/*.test.js",
		"test:unit": "node --test --test-concurrency=1 tests/unit/**/*.test.js",
		"test:integration": "node --test --test-concurrency=1 tests/integration/**/*.test.js",
		"test:e2e": "node --test --test-concurrency=1 tests/e2e/**/*.test.js",
		"test:smoke": "node --test tests/smoke/**/*.test.js",
		"test:ci": "run-s test test:smoke test:e2e",
		"test:prod": "cross-env BUILD_MODE=build pnpm run test:e2e",
		"test:export": "cross-env BUILD_MODE=export pnpm run test:e2e",
		"test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage tests/**/*.test.js",
		"serve:build": "npx serve build-prod",
		"verify:pipeline": "run-s lint test build test:smoke test:prod sanity:budget",
		"sanity:budget": "size-limit",
		"component": "plop"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cebreus/gulp-devstack.git"
	},
	"homepage": "https://github.com/cebreus/gulp-devstack#readme",
	"author": "Jaroslav Vrana <cebreus@live.com>",
	"private": false,
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/cebreus/gulp-devstack/issues",
		"email": "cebreus@live.com"
	},
	"keywords": [
		"devstack",
		"gulp",
		"bootstrap"
	],
	"engines": {
		"node": ">=22"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix"
		],
		"*.scss": [
			"stylelint --fix --allow-empty-input"
		],
		"*.md": [
			"remark --output --quiet --frail"
		],
		"*.njk": [
			"njklint --fix"
		],
		"*.{css,scss,js,json,njk}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"bootstrap": "5.3.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/eslintrc": "^3.3.5",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@playwright/test": "^1.59.1",
		"@popperjs/core": "^2.11.8",
		"@size-limit/preset-big-lib": "^12.1.0",
		"@visionappscz/stylelint-config": "^4.0.0",
		"autoprefixer": "^10.5.0",
		"browser-sync": "^3.0.4",
		"cross-env": "^10.1.0",
		"cssnano": "^7.1.5",
		"del": "^8.0.1",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^62.9.0",
		"eslint-plugin-regexp": "^2.10.0",
		"favicons": "^7.2.0",
		"glob": "^13.0.6",
		"globals": "^17.5.0",
		"gray-matter": "^4.0.3",
		"gulp": "^5.0.1",
		"gulp-concat": "^2.6.1",
		"gulp-data": "^1.3.1",
		"gulp-esbuild": "^0.14.1",
		"gulp-google-webfonts": "^4.1.0",
		"gulp-htmlmin": "^5.0.1",
		"gulp-imagemin": "^9.2.0",
		"gulp-inject": "^5.0.5",
		"gulp-jsbeautifier": "^3.0.1",
		"gulp-newer": "^1.4.0",
		"gulp-nunjucks-render": "^2.2.3",
		"gulp-postcss": "^10.0.0",
		"gulp-purgecss": "^8.0.0",
		"gulp-replace": "^1.1.4",
		"gulp-rev": "^12.0.0",
		"gulp-rev-delete-original": "^0.2.3",
		"gulp-rev-rewrite": "^6.0.0",
		"gulp-sass": "^6.0.1",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-sri-hash": "^2.2.1",
		"gulp-todo": "^7.1.1",
		"gulp-upng": "^1.0.3",
		"html-validate": "^10.13.0",
		"husky": "^9.1.7",
		"imagemin-svgo": "^12.0.0",
		"linkinator": "^7.6.1",
		"lint-staged": "^16.4.0",
		"markdown-it": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"nunjucklinter": "^1.3.0",
		"nunjucks": "^3.2.4",
		"picocolors": "^1.1.1",
		"plop": "^4.0.5",
		"postcss": "^8.5.10",
		"prettier": "^3.8.3",
		"prettier-plugin-jinja-template": "^2.1.0",
		"prompts": "^2.4.2",
		"remark": "^15.0.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-lint": "^10.0.1",
		"remark-lint-code": "^2.0.0",
		"remark-lint-heading-whitespace": "^1.0.0",
		"remark-lint-no-duplicate-headings": "^4.0.1",
		"remark-preset-lint-consistent": "^6.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"rimraf": "^6.1.3",
		"sass": "^1.99.0",
		"sharp": "^0.34.5",
		"size-limit": "^12.1.0",
		"stylelint": "^17.8.0",
		"stylelint-config-prettier-scss": "^1.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-high-performance-animation": "^2.0.0",
		"stylelint-selector-bem-pattern": "^4.0.1"
	}
}
