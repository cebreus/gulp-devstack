{
  "endOfLine": "lf",
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "bracketSpacing": true,
  "semi": true,
  "arrowParens": "always",
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^gulp$",
    "^./gulpconfig",
    "",
    "^./src/lib/tasks/",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "overrides": [{
      "files": ["*.js", "*.mjs", "*.cjs"],
      "options": {
        "printWidth": 80
      }
    },
    {
      "files": ["*.json"],
      "options": {
        "useTabs": true
      }
    },
    {
      "files": ["*.yml", "*.yaml", "package.json"],
      "options": {
        "tabWidth": 2,
        "useTabs": false
      }
    },
    {
      "files": ["*.njk", "*.html"],
      "options": {
        "parser": "jinja-template"
      }
    }
  ]
}
